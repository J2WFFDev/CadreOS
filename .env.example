DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&pgbouncer=true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RELEASE_ARC="21D"
NEXT_PUBLIC_BUILD_ITERATION="21D.3"
NEXT_PUBLIC_GIT_SHA="localdev"
NEXT_PUBLIC_NAV_VERSION="2"
NEXT_PUBLIC_APP_ENV="local"
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=""
NEXT_PUBLIC_VERCEL_ENV=""
NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Clerk v5+ redirect env vars (replaces deprecated NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
CADREOS_ENTRY_RUNTIME_NOTES_SIDECAR_WRITE="false"
CADREOS_ENTRY_RUNTIME_TASKS_SIDECAR_WRITE="false"
# Dev-only: set to "true" to enable persona seed validation and debug endpoints.
# Never set in production. See docs/testing/role-persona-testing.md.
ENABLE_TEST_PERSONAS="false"
# Dev-only: set to "true" to emit [role-debug] logs from getCurrentCadreUser() and related helpers.
# Never set in production.
ENABLE_ROLE_DEBUG="false"
