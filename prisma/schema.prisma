  relatedEvent Event?       @relation("GearInspectionRecordEvent", fields: [relatedEventId], references: [id], onDelete: SetNull)

  @@index([organizationId, gearItemId, performedAt])
  @@index([organizationId, result, performedAt])
  @@index([organizationId, inspectedByPersonId, performedAt])
  @@index([organizationId, context, performedAt])
  @@index([organizationId, relatedEventId, performedAt])
}

model ConsumableTransaction {
