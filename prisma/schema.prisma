generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

enum RoleType {
  ORGANIZATION_ADMIN
  PROGRAM_DIRECTOR
  COACH
  ASSISTANT_COACH
  PARENT_GUARDIAN
  ATHLETE
}

enum NoteVisibility {
  STAFF_ONLY
}

enum EntryRuntimeSourceModelType {
  OBSERVATION_NOTE
  FOLLOW_UP_TASK
}

enum EntryRuntimeKind {
  NOTE
  TASK
}

enum EntryRuntimeVisibilityClass {
  STAFF_ONLY
  TEAM_STAFF
  ORGANIZATION_SCOPED
}

enum EventType {
  PRACTICE
  GAME
  MATCH
  MEETING
  TRAVEL
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum RSVPStatus {
  GOING
  NOT_GOING
  MAYBE
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED_ABSENT
  UNEXCUSED_ABSENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum InboxItemStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ScopeType {
  ORGANIZATION
  PROGRAM
  TEAM
}

enum RelationshipType {
  PARENT
  GUARDIAN
}

// FieldOps enums

enum FacilityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum ResourceType {
  FIELD
  RANGE
  BAY
  ROOM
  COURT
  EQUIPMENT_AREA
  OTHER
}

enum BookingStatus {
  DRAFT
  REQUESTED
  PRECHECK_PASSED
  CONFLICT_FOUND
  RECOMMENDED
  APPROVED
  DENIED
  CANCELED
  COMPLETED
}

enum PrecheckStatus {
  NOT_RUN
  PASSED
  WARNING
  FAILED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  DENIED
}

enum ConflictType {
  RESOURCE_TIME_OVERLAP
  FACILITY_BLACKOUT
  EVENT_OVERLAP
  MISSING_REQUIRED_STAFF
  RESOURCE_UNAVAILABLE
  CAPACITY_EXCEEDED
  POLICY_WARNING
}

enum ConflictSeverity {
  INFO
  WARNING
  BLOCKING
}

// GearOps enums

enum GearInventoryType {
  DURABLE
  CONSUMABLE
}

enum GearItemLifecycleStatus {
  ACTIVE
  ASSIGNED
  CHECKED_OUT
  MAINTENANCE
  RETIRED
  LOST
}

enum GearConditionStatus {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
  RETIRED
}

enum GearAssignmentStatus {
  PENDING
  ACTIVE
  RETURNED
  TRANSFERRED
  CANCELLED
  OVERDUE
}

enum GearCheckoutStatus {
  OPEN
  RETURNED
  OVERDUE
  LOST
}

enum GearMaintenanceType {
  INSPECTION
  REPAIR
  CLEANING
  REPLACEMENT
  RETIREMENT
}

enum ConsumableTransactionType {
  RECEIVED
  USED
  DISTRIBUTED
  DISPOSED
  ADJUSTED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  programs                    Program[]
  people                      Person[]
  users                       UserAccount[]
  teams                       Team[]
  seasons                     Season[]
  roleAssignments             RoleAssignment[]
  athleteGuardianRelationships AthleteGuardianRelationship[]
  rosterMemberships           RosterMembership[]
  observationNotes            ObservationNote[]
  events                      Event[]
  rsvps                       RSVP[]
  attendanceRecords           AttendanceRecord[]
  followUpTasks               FollowUpTask[]
  entryRuntimeRefs            EntryRuntimeRef[]
  inboxRoutingItems           InboxRoutingItem[]
  auditEvents                 AuditEvent[]
  facilities                  Facility[]
  facilityResources           FacilityResource[]
  resourceBookings            ResourceBooking[]
  bookingConflicts            BookingConflict[]
  gearCategories              GearCategory[]
  gearItems                   GearItem[]
  gearAssignments             GearAssignment[]
  gearCheckouts               GearCheckout[]
  gearMaintenanceLogs         GearMaintenanceLog[]
  consumableTransactions      ConsumableTransaction[]
}

model Program {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teams        Team[]
  seasons      Season[]
  roles        RoleAssignment[]
  events       Event[]
  auditEvents  AuditEvent[]
  resourceBookings ResourceBooking[]
  gearItems    GearItem[]

  @@index([organizationId])
  @@unique([organizationId, name])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  programId      String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  roles        RoleAssignment[]
  roster       RosterMembership[]
  notes        ObservationNote[]
  events       Event[]
  auditEvents  AuditEvent[]
  resourceBookings ResourceBooking[]
  gearAssignments GearAssignment[]

  @@index([organizationId, programId])
  @@unique([programId, name])
}

model Season {
  id             String   @id @default(cuid())
  organizationId String
  programId      String
  name           String
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  roster       RosterMembership[]

  @@index([organizationId, programId])
  @@unique([programId, name])
}

model UserAccount {
  id             String   @id @default(cuid())
  organizationId String
  clerkUserId    String   @unique
  personId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Person {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccounts               UserAccount[]
  roles                      RoleAssignment[]
  roster                     RosterMembership[]
  authoredNotes              ObservationNote[]            @relation("NoteAuthor")
  athleteNotes               ObservationNote[]            @relation("NoteAthlete")
  eventRsvps                 RSVP[]
  attendance                 AttendanceRecord[]           @relation("AttendancePerson")
  markedAttendanceRecords    AttendanceRecord[]           @relation("AttendanceMarkedBy")
  assignedTasks              FollowUpTask[]               @relation("TaskAssignee")
  createdTasks               FollowUpTask[]               @relation("TaskCreator")
  authoredEntryRuntimeRefs   EntryRuntimeRef[]            @relation("EntryRuntimeRefAuthor")
  guardianLinks              AthleteGuardianRelationship[] @relation("GuardianSide")
  athleteLinks               AthleteGuardianRelationship[] @relation("AthleteSide")
  ownedInboxRoutingItems     InboxRoutingItem[]           @relation("InboxOwner")
  createdInboxRoutingItems   InboxRoutingItem[]           @relation("InboxCreatedBy")
  createdEvents              Event[]                      @relation("EventCreatedBy")
  actorAuditEvents           AuditEvent[]                 @relation("AuditActor")
  requestedBookings          ResourceBooking[]            @relation("BookingRequestedBy")
  approvedBookings           ResourceBooking[]            @relation("BookingApprovedBy")
  assignedGear               GearAssignment[]             @relation("GearAssignmentToPerson")
  createdGearAssignments     GearAssignment[]             @relation("GearAssignmentByPerson")
  checkedOutGear             GearCheckout[]               @relation("GearCheckoutTakenBy")
  issuedGear                 GearCheckout[]               @relation("GearCheckoutIssuedBy")
  returnedGear               GearCheckout[]               @relation("GearCheckoutReturnedBy")
  receivedGear               GearCheckout[]               @relation("GearCheckoutReceivedBy")
  gearMaintenanceLogs        GearMaintenanceLog[]
  recordedConsumableTransactions ConsumableTransaction[]

  @@index([organizationId])
  @@index([organizationId, lastName, firstName])
}

model RoleAssignment {
  id             String    @id @default(cuid())
  organizationId String
  personId       String
  roleType       RoleType
  scopeType      ScopeType
  programId      String?
  teamId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  program      Program?     @relation(fields: [programId], references: [id], onDelete: Restrict)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([organizationId, personId])
  @@index([organizationId, roleType, scopeType])
  @@unique([personId, roleType, scopeType, programId, teamId])
}

model AthleteGuardianRelationship {
  id               String           @id @default(cuid())
  organizationId   String
  athletePersonId  String
  guardianPersonId String
  relationshipType RelationshipType
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  athlete      Person       @relation("AthleteSide", fields: [athletePersonId], references: [id], onDelete: Cascade)
  guardian     Person       @relation("GuardianSide", fields: [guardianPersonId], references: [id], onDelete: Cascade)

  @@index([organizationId, athletePersonId])
  @@index([organizationId, guardianPersonId])
  @@unique([organizationId, athletePersonId, guardianPersonId, relationshipType])
}

model RosterMembership {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String
  seasonId       String
  personId       String
  rosterRole     RoleType
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season       Season       @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([organizationId, teamId, seasonId])
  @@index([organizationId, personId])
  @@unique([teamId, seasonId, personId])
}

model ObservationNote {
  id              String         @id @default(cuid())
  organizationId  String
  authorPersonId  String
  athletePersonId String?
  teamId          String?
  eventId         String?
  body            String
  visibility      NoteVisibility @default(STAFF_ONLY)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       Person       @relation("NoteAuthor", fields: [authorPersonId], references: [id], onDelete: Restrict)
  athlete      Person?      @relation("NoteAthlete", fields: [athletePersonId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tasks        FollowUpTask[]

  @@index([organizationId, createdAt])
  @@index([organizationId, athletePersonId, createdAt])
  @@index([organizationId, teamId, createdAt])
}

model EntryRuntimeRef {
  id               String                          @id @default(cuid())
  organizationId   String
  sourceModelType  EntryRuntimeSourceModelType
  sourceModelId    String
  entryKind        EntryRuntimeKind
  authorPersonId   String
  visibilityClass  EntryRuntimeVisibilityClass
  athletePersonId  String?
  teamId           String?
  eventId          String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       Person       @relation("EntryRuntimeRefAuthor", fields: [authorPersonId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceModelType, sourceModelId])
  @@index([organizationId, entryKind, createdAt])
  @@index([organizationId, authorPersonId, createdAt])
  @@index([organizationId, athletePersonId, createdAt])
  @@index([organizationId, teamId, createdAt])
  @@index([organizationId, eventId, createdAt])
}

model Event {
  id                String      @id @default(cuid())
  organizationId    String
  programId         String
  teamId            String?
  title             String
  eventType         EventType
  status            EventStatus @default(DRAFT)
  startsAt          DateTime
  endsAt            DateTime?
  location          String?
  createdByPersonId String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy    Person       @relation("EventCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  rsvps        RSVP[]
  attendance   AttendanceRecord[]
  notes        ObservationNote[]
  tasks        FollowUpTask[]
  resourceBookings ResourceBooking[]
  gearAssignments GearAssignment[]
  gearCheckouts   GearCheckout[]
  consumableTransactions ConsumableTransaction[]

  @@index([organizationId, startsAt])
  @@index([organizationId, teamId, startsAt])
}

model RSVP {
  id             String     @id @default(cuid())
  organizationId String
  eventId        String
  personId       String
  status         RSVPStatus
  reason         String?
  respondedAt    DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId])
  @@index([organizationId, personId])
  @@unique([eventId, personId])
}

model AttendanceRecord {
  id               String           @id @default(cuid())
  organizationId   String
  eventId          String
  personId         String
  status           AttendanceStatus
  reasonCode       String?
  markedByPersonId String
  markedAt         DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person       Person       @relation("AttendancePerson", fields: [personId], references: [id], onDelete: Restrict)
  markedBy     Person       @relation("AttendanceMarkedBy", fields: [markedByPersonId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId])
  @@index([organizationId, personId])
  @@unique([eventId, personId])
}

model FollowUpTask {
  id                String     @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  status            TaskStatus @default(OPEN)
  assigneePersonId  String
  createdByPersonId String
  dueAt             DateTime?
  sourceNoteId      String?
  sourceEventId     String?
  sourceInboxItemId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignee      Person           @relation("TaskAssignee", fields: [assigneePersonId], references: [id], onDelete: Restrict)
  createdBy     Person           @relation("TaskCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  sourceNote    ObservationNote? @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  sourceEvent   Event?           @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  sourceInboxItem InboxRoutingItem? @relation(fields: [sourceInboxItemId], references: [id], onDelete: SetNull)

  @@index([organizationId, assigneePersonId, status, dueAt])
}

model InboxRoutingItem {
  id                String          @id @default(cuid())
  organizationId    String
  category          String
  subjectRefType    String
  subjectRefId      String
  priority          Int             @default(0)
  status            InboxItemStatus @default(OPEN)
  ownerPersonId     String?
  createdByPersonId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        Person?       @relation("InboxOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  createdBy    Person        @relation("InboxCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  tasks        FollowUpTask[]

  @@index([organizationId, status, priority])
  @@index([organizationId, subjectRefType, subjectRefId])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  programId      String?
  teamId         String?
  actorPersonId  String?
  action         String
  entityType     String
  entityId       String
  beforeJson     String?
  afterJson      String?
  metadataJson   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        Person?      @relation("AuditActor", fields: [actorPersonId], references: [id], onDelete: SetNull)
  program      Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, actorPersonId, createdAt])
}

// FieldOps models

model Facility {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  status         FacilityStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resources    FacilityResource[]
  bookings     ResourceBooking[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model FacilityResource {
  id             String         @id @default(cuid())
  organizationId String
  facilityId     String
  name           String
  resourceType   ResourceType
  description    String?
  capacity       Int?
  status         ResourceStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  bookings     ResourceBooking[]

  @@index([organizationId])
  @@index([facilityId])
  @@index([organizationId, facilityId])
  @@index([organizationId, status])
}

model ResourceBooking {
  id                  String         @id @default(cuid())
  organizationId      String
  facilityId          String
  resourceId          String
  programId           String?
  teamId              String?
  eventId             String?
  requestedByPersonId String
  approvedByPersonId  String?
  title               String
  description         String?
  startsAt            DateTime
  endsAt              DateTime
  status              BookingStatus  @default(DRAFT)
  precheckStatus      PrecheckStatus @default(NOT_RUN)
  approvalStatus      ApprovalStatus @default(NOT_REQUIRED)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility     Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  resource     FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  program      Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  requestedBy  Person           @relation("BookingRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  approvedBy   Person?          @relation("BookingApprovedBy", fields: [approvedByPersonId], references: [id], onDelete: SetNull)
  conflicts    BookingConflict[] @relation("BookingConflicts")
  relatedConflicts BookingConflict[] @relation("RelatedBookingConflicts")

  @@index([organizationId])
  @@index([organizationId, facilityId])
  @@index([organizationId, resourceId])
  @@index([organizationId, status])
  @@index([organizationId, approvalStatus])
  @@index([organizationId, eventId])
  @@index([resourceId, startsAt])
  @@index([resourceId, endsAt])
}

model BookingConflict {
  id               String           @id @default(cuid())
  organizationId   String
  bookingId        String
  conflictType     ConflictType
  severity         ConflictSeverity
  message          String
  relatedBookingId String?
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking        ResourceBooking @relation("BookingConflicts", fields: [bookingId], references: [id], onDelete: Cascade)
  relatedBooking ResourceBooking? @relation("RelatedBookingConflicts", fields: [relatedBookingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bookingId])
  @@index([organizationId, bookingId])
  @@index([relatedBookingId])
}

// GearOps models

model GearCategory {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  inventoryType  GearInventoryType
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItems     GearItem[]

  @@index([organizationId, inventoryType])
  @@unique([organizationId, name])
}

model GearItem {
  id                  String                 @id @default(cuid())
  organizationId      String
  programId           String?
  gearCategoryId      String
  name                String
  inventoryType       GearInventoryType
  sku                 String?
  serialNumber        String?
  quantityOnHand      Int                    @default(0)
  quantityMin         Int?
  lifecycleStatus     GearItemLifecycleStatus @default(ACTIVE)
  conditionStatus     GearConditionStatus?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program                Program?                @relation(fields: [programId], references: [id], onDelete: SetNull)
  category               GearCategory            @relation(fields: [gearCategoryId], references: [id], onDelete: Restrict)
  assignments            GearAssignment[]
  checkouts              GearCheckout[]
  maintenanceLogs        GearMaintenanceLog[]
  consumableTransactions ConsumableTransaction[]

  @@index([organizationId, gearCategoryId])
  @@index([organizationId, programId])
  @@index([organizationId, inventoryType, lifecycleStatus])
  @@unique([organizationId, serialNumber])
}

model GearAssignment {
  id                 String               @id @default(cuid())
  organizationId     String
  gearItemId         String
  assignedToPersonId String?
  assignedToTeamId   String?
  assignedToEventId  String?
  assignedByPersonId String
  assignedAt         DateTime             @default(now())
  expectedReturnAt   DateTime?
  returnedAt         DateTime?
  status             GearAssignmentStatus @default(PENDING)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItem      GearItem      @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  assignedTo    Person?       @relation("GearAssignmentToPerson", fields: [assignedToPersonId], references: [id], onDelete: SetNull)
  assignedTeam  Team?         @relation(fields: [assignedToTeamId], references: [id], onDelete: SetNull)
  assignedEvent Event?        @relation(fields: [assignedToEventId], references: [id], onDelete: SetNull)
  assignedBy    Person        @relation("GearAssignmentByPerson", fields: [assignedByPersonId], references: [id], onDelete: Restrict)

  @@index([organizationId, gearItemId, status])
  @@index([organizationId, assignedToPersonId, status])
  @@index([organizationId, assignedToTeamId, status])
  @@index([organizationId, assignedToEventId, status])
  @@index([organizationId, expectedReturnAt, status])
}

model GearCheckout {
  id                 String             @id @default(cuid())
  organizationId     String
  gearItemId         String
  eventId            String?
  checkedOutById     String
  issuedById         String
  returnedById       String?
  receivedById       String?
  checkedOutAt       DateTime           @default(now())
  expectedReturnAt   DateTime?
  returnedAt         DateTime?
  status             GearCheckoutStatus @default(OPEN)
  conditionOnReturn  GearConditionStatus?
  purposeNotes       String?
  returnNotes        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItem      GearItem      @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  checkedOutBy  Person        @relation("GearCheckoutTakenBy", fields: [checkedOutById], references: [id], onDelete: Restrict)
  issuedBy      Person        @relation("GearCheckoutIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  returnedBy    Person?       @relation("GearCheckoutReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  receivedBy    Person?       @relation("GearCheckoutReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([organizationId, gearItemId, status])
  @@index([organizationId, checkedOutById, status])
  @@index([organizationId, issuedById, status])
  @@index([organizationId, eventId, status])
  @@index([organizationId, expectedReturnAt, status])
}

model GearMaintenanceLog {
  id                  String              @id @default(cuid())
  organizationId      String
  gearItemId          String
  performedByPersonId String
  maintenanceType     GearMaintenanceType
  performedAt         DateTime            @default(now())
  conditionBefore     GearConditionStatus?
  conditionAfter      GearConditionStatus?
  notes               String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItem      GearItem      @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  performedBy   Person        @relation(fields: [performedByPersonId], references: [id], onDelete: Restrict)

  @@index([organizationId, gearItemId, performedAt])
  @@index([organizationId, performedByPersonId, performedAt])
  @@index([organizationId, maintenanceType, performedAt])
}

model ConsumableTransaction {
  id                  String                    @id @default(cuid())
  organizationId      String
  gearItemId          String
  transactionType     ConsumableTransactionType
  quantityDelta       Int
  recordedByPersonId  String
  eventId             String?
  recordedAt          DateTime                  @default(now())
  notes               String?
  createdAt           DateTime                  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItem      GearItem      @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  recordedBy    Person        @relation(fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, gearItemId, recordedAt])
  @@index([organizationId, transactionType, recordedAt])
  @@index([organizationId, recordedByPersonId, recordedAt])
  @@index([organizationId, eventId, recordedAt])
}
