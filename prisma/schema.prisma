  stagingLocationId      String?
  recoveryLocationId     String?
  deploymentLocationText String?
  checklistNotes         String?
  stagingNotes           String?
  recoveryNotes          String?
  readinessCheckedAt     DateTime?
  preparedByPersonId     String?
  preparedAt             DateTime?
  createdByPersonId      String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event            Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stagingLocation  InventoryLocation?     @relation("EventGearPlanStagingLocation", fields: [stagingLocationId], references: [id], onDelete: SetNull)
  recoveryLocation InventoryLocation?     @relation("EventGearPlanRecoveryLocation", fields: [recoveryLocationId], references: [id], onDelete: SetNull)
  preparedBy       Person?                @relation("EventGearPlanPreparedBy", fields: [preparedByPersonId], references: [id], onDelete: SetNull)
  createdBy        Person                 @relation("EventGearPlanCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  requirements     EventGearRequirement[]
  assignments      EventGearAssignment[]

