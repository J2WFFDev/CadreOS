  gearCategory GearCategory?         @relation(fields: [gearCategoryId], references: [id], onDelete: SetNull)
  assignments  EventGearAssignment[]

  @@index([organizationId, planId, requirementType])
  @@index([organizationId, gearCategoryId])
}

model EventGearAssignment {
  id                    String               @id @default(cuid())
  organizationId        String
  planId                String
  requirementId         String
  gearItemId            String
  assignedByPersonId    String
  assignedAt            DateTime             @default(now())
  stagedByPersonId      String?
  stagedAt              DateTime?
  stagedFromLocationId  String?
  stagedToLocationId    String?
  recoveredByPersonId   String?
  recoveredAt           DateTime?
  recoveredToLocationId String?
  conditionOnRecovery   GearConditionStatus?
  maintenanceFlag       Boolean              @default(false)
  notes                 String?
  recoveryNotes         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan                EventGearPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  requirement         EventGearRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  gearItem            GearItem             @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  assignedBy          Person               @relation("EventGearAssignmentCreatedBy", fields: [assignedByPersonId], references: [id], onDelete: Restrict)
  stagedBy            Person?              @relation("EventGearAssignmentStagedBy", fields: [stagedByPersonId], references: [id], onDelete: SetNull)
  recoveredBy         Person?              @relation("EventGearAssignmentRecoveredBy", fields: [recoveredByPersonId], references: [id], onDelete: SetNull)
  stagedFromLocation  InventoryLocation?   @relation("EventGearAssignmentStagedFromLocation", fields: [stagedFromLocationId], references: [id], onDelete: SetNull)
  stagedToLocation    InventoryLocation?   @relation("EventGearAssignmentStagedToLocation", fields: [stagedToLocationId], references: [id], onDelete: SetNull)
  recoveredToLocation InventoryLocation?   @relation("EventGearAssignmentRecoveredToLocation", fields: [recoveredToLocationId], references: [id], onDelete: SetNull)

  @@unique([planId, gearItemId])
  @@index([organizationId, planId, assignedAt])
  @@index([organizationId, requirementId, assignedAt])
  @@index([organizationId, gearItemId, assignedAt])
