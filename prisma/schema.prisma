// Arc 20I: GearCategoryField — optional typed custom fields per category

model GearCategoryField {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  fieldKey       String
  fieldLabel     String
  fieldType      String
  fieldOptions   String?
  required       Boolean  @default(false)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     GearCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, fieldKey])
  @@index([organizationId, categoryId])
}

// Arc 20I: EventGearRequirementTemplate — reusable org-level gear requirement templates for events

model EventGearRequirementTemplate {
  id              String                   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  gearCategoryId  String?
  label           String
  requirementType EventGearRequirementType @default(REQUIRED)
  quantityNeeded  Int                      @default(1)
  notes           String?
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearCategory GearCategory? @relation(fields: [gearCategoryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, gearCategoryId])
  @@index([organizationId, isActive])
}

// Arc 20I: GearOpsOrganizationSettings — org-level GearOps configuration

model GearOpsOrganizationSettings {
  id                        String          @id @default(cuid())
  organizationId            String          @unique
  defaultCustodyMode        GearCustodyMode @default(FREE_CHECKOUT)
  enableGuardianApproval    Boolean         @default(false)
  enableConsumableTracking  Boolean         @default(true)
  enableEventDeployment     Boolean         @default(true)
  enableReadinessTracking   Boolean         @default(true)
  enableMaintenanceTracking Boolean         @default(true)
  defaultReportGroup        GearReportGroup @default(GENERAL)
  adminNotes                String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

// Arc 19E: WorkflowTemplate — reusable, organization-scoped operational workflow templates.
// Each template carries a typed set of ordered step definitions (stepsJson).

model WorkflowTemplate {
  id                String               @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  templateType      WorkflowTemplateType
  stepsJson         String
  createdByPersonId String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  archivedAt        DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    Person        @relation("WorkflowTemplateCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  runs         WorkflowRun[]

  @@index([organizationId])
  @@index([organizationId, templateType])
  @@index([organizationId, archivedAt])
}

// Arc 19E: WorkflowRun — a single execution of a WorkflowTemplate.
// Optionally anchored to an Entry that triggered the workflow.

model WorkflowRun {
  id                 String            @id @default(cuid())
  organizationId     String
  workflowTemplateId String
  anchorEntryId      String?
  status             WorkflowRunStatus @default(ACTIVE)
  currentStepIndex   Int               @default(0)
  startedByPersonId  String
  assignedToPersonId String?
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  metadataJson       String?

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowTemplate WorkflowTemplate    @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)
  anchorEntry      Entry?              @relation(fields: [anchorEntryId], references: [id], onDelete: SetNull)
  startedBy        Person              @relation("WorkflowRunStartedBy", fields: [startedByPersonId], references: [id], onDelete: Restrict)
  stepEntries      WorkflowStepEntry[]
  awarenessEvents  AwarenessEvent[]
  notifications    Notification[]

  @@index([organizationId, status])
  @@index([organizationId, workflowTemplateId])
  @@index([organizationId, anchorEntryId])
  @@index([organizationId, startedByPersonId])
}

// Arc 19E: WorkflowStepEntry — ties a WorkflowRun step to the Entry created for that step.

model WorkflowStepEntry {
  id             String    @id @default(cuid())
  organizationId String
  workflowRunId  String
  stepIndex      Int
  entryId        String    @unique
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowRun  WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  entry        Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([organizationId, workflowRunId])
  @@index([organizationId, entryId])
}

model AwarenessEvent {
  id             String               @id @default(cuid())
  organizationId String
  eventType      AwarenessEventType
  category       NotificationCategory
  priority       EntryPriority        @default(MEDIUM)
  aggregateKey   String
  title          String
  body           String
  href           String
  entryId        String?
  workflowRunId  String?
  eventId        String?
  teamId         String?
  actorPersonId  String?
  metadataJson   String?
  occurredAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry         Entry?         @relation(fields: [entryId], references: [id], onDelete: SetNull)
  workflowRun   WorkflowRun?   @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor         Person?        @relation("AwarenessEventActor", fields: [actorPersonId], references: [id], onDelete: SetNull)
  notifications Notification[] @relation("NotificationLatestAwarenessEvent")

  @@index([organizationId, category, occurredAt])
  @@index([organizationId, aggregateKey, occurredAt])
  @@index([organizationId, actorPersonId, occurredAt])
  @@index([organizationId, entryId, occurredAt])
  @@index([organizationId, workflowRunId, occurredAt])
  @@index([organizationId, eventId, occurredAt])
}

model Notification {
  id                     String               @id @default(cuid())
  organizationId         String
  aggregateKey           String
  category               NotificationCategory
  priority               EntryPriority        @default(MEDIUM)
  latestAwarenessEventId String
  entryId                String?
  workflowRunId          String?
  teamId                 String?
  title                  String
  body                   String
  href                   String
  eventCount             Int                  @default(1)
  firstEventAt           DateTime
  lastEventAt            DateTime
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  latestAwarenessEvent AwarenessEvent          @relation("NotificationLatestAwarenessEvent", fields: [latestAwarenessEventId], references: [id], onDelete: Restrict)
  entry                Entry?                  @relation(fields: [entryId], references: [id], onDelete: SetNull)
  workflowRun          WorkflowRun?            @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  readStates           NotificationReadState[]

  @@unique([organizationId, aggregateKey])
  @@index([organizationId, category, lastEventAt])
  @@index([organizationId, entryId])
  @@index([organizationId, workflowRunId])
}

model NotificationReadState {
  id             String    @id @default(cuid())
  organizationId String
  notificationId String
  personId       String
  readAt         DateTime?
  archivedAt     DateTime?
  deliveredAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([notificationId, personId])
  @@index([organizationId, personId, readAt])
  @@index([organizationId, personId, archivedAt, deliveredAt])
}

model NotificationPreference {
  id                 String                     @id @default(cuid())
  organizationId     String
  personId           String
  minimumPriority    EntryPriority              @default(LOW)
  deliveryTiming     NotificationDeliveryTiming @default(IMMEDIATE)
  digestWindowHours  Int                        @default(24)
  assignmentEnabled  Boolean                    @default(true)
  followUpEnabled    Boolean                    @default(true)
  readinessEnabled   Boolean                    @default(true)
  workflowEnabled    Boolean                    @default(true)
  statusEnabled      Boolean                    @default(true)
  linkedIssueEnabled Boolean                    @default(true)
  attendanceEnabled  Boolean                    @default(true)
  dueEnabled         Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personId])
  @@index([organizationId, personId, deliveryTiming])
}

model NotificationDigest {
  id                  String                     @id @default(cuid())
  organizationId      String
  personId            String
  status              NotificationDigestStatus   @default(PENDING)
  deliveryTiming      NotificationDeliveryTiming @default(DIGEST_ONLY)
  windowStartsAt      DateTime
  windowEndsAt        DateTime
  notificationIdsJson String?
  builtAt             DateTime?
  dismissedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personId, deliveryTiming, windowStartsAt, windowEndsAt])
  @@index([organizationId, personId, status, windowStartsAt])
  @@index([organizationId, status, windowEndsAt])
}

// Arc 20A: Inventory Operations Architecture

// InventoryLocation — physical or logical storage location (vault, cage, shelf, team bag, etc.)
model InventoryLocation {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  locationCode     String?
  parentLocationId String?
  isActive         Boolean                    @default(true)
  locationType     GearLocationClassification @default(GENERAL)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime @updatedAt

  organization                          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentLocation                        InventoryLocation?          @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations                        InventoryLocation[]         @relation("LocationHierarchy")
  gearItems                             GearItem[]
  movementsFrom                         InventoryMovement[]         @relation("MovementFromLocation")
  movementsTo                           InventoryMovement[]         @relation("MovementToLocation")
  scanEvents                            InventoryScanEvent[]
  eventGearPlansAsStagingLocation       EventGearPlan[]             @relation("EventGearPlanStagingLocation")
  eventGearPlansAsRecoveryLocation      EventGearPlan[]             @relation("EventGearPlanRecoveryLocation")
  stagedEventGearAssignmentsFrom        EventGearAssignment[]       @relation("EventGearAssignmentStagedFromLocation")
  stagedEventGearAssignmentsTo          EventGearAssignment[]       @relation("EventGearAssignmentStagedToLocation")
  recoveredEventGearAssignments         EventGearAssignment[]       @relation("EventGearAssignmentRecoveredToLocation")
  inventoryAuditExpectedLocationResults InventoryAuditResult[]      @relation("InventoryAuditExpectedLocation")
  inventoryAuditObservedLocationResults InventoryAuditResult[]      @relation("InventoryAuditObservedLocation")
  inventoryAuditDiscrepancies           InventoryAuditDiscrepancy[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, parentLocationId])
}

// InventoryMovement — immutable movement event record providing full item history and custody traceability
model InventoryMovement {
  id                String                @id @default(cuid())
  organizationId    String
  gearItemId        String
  movementType      InventoryMovementType
  fromLocationId    String?
  toLocationId      String?
  actorPersonId     String
  custodyPersonId   String?
  relatedRecordType String?
  relatedRecordId   String?
  notes             String?
  occurredAt        DateTime              @default(now())
  createdAt         DateTime              @default(now())

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItem      GearItem           @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  fromLocation  InventoryLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation    InventoryLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  actor         Person             @relation("InventoryMovementActor", fields: [actorPersonId], references: [id], onDelete: Restrict)
  custodyPerson Person?            @relation("InventoryMovementCustody", fields: [custodyPersonId], references: [id], onDelete: SetNull)

  @@index([organizationId, gearItemId, occurredAt])
  @@index([organizationId, movementType, occurredAt])
  @@index([organizationId, actorPersonId, occurredAt])
  @@index([organizationId, custodyPersonId, occurredAt])
  @@index([organizationId, fromLocationId, occurredAt])
  @@index([organizationId, toLocationId, occurredAt])
}

// InventoryKit — Arc 20X: advanced operational kit or loadout grouping multiple gear items for coordinated use
model InventoryKit {
  id                    String                  @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  kitType               GearKitType             @default(KIT)
  ownerPersonId         String?
  assignedToPersonId    String?
  assignedToTeamId      String?
  assignedToEventId     String?
  labelCode             String?
  readinessLabel        GearKitReadinessLabel   @default(INCOMPLETE)
  custodyStatus         GearKitCustodyStatus    @default(AVAILABLE)
  lastInspectedAt       DateTime?
  lastInspectionStatus  GearKitInspectionStatus?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner           Person?               @relation("InventoryKitOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  assignedTo      Person?               @relation("InventoryKitAssignedTo", fields: [assignedToPersonId], references: [id], onDelete: SetNull)
  assignedToTeam  Team?                 @relation("InventoryKitAssignedToTeam", fields: [assignedToTeamId], references: [id], onDelete: SetNull)
  assignedToEvent Event?                @relation("InventoryKitAssignedToEvent", fields: [assignedToEventId], references: [id], onDelete: SetNull)
  items           InventoryKitItem[]
  inspections     GearKitInspection[]
  custodyEvents   GearKitCustodyEvent[]

  @@unique([organizationId, name])
  @@unique([organizationId, labelCode])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, kitType])
  @@index([organizationId, custodyStatus])
  @@index([organizationId, readinessLabel])
  @@index([organizationId, ownerPersonId])
  @@index([organizationId, assignedToPersonId])
  @@index([organizationId, assignedToEventId])
}

// InventoryKitItem — Arc 20X: extended join table linking GearItems to InventoryKits with component role and metadata
model InventoryKitItem {
  id               String               @id @default(cuid())
  organizationId   String
  kitId            String
  gearItemId       String
  componentRole    GearKitComponentRole @default(REQUIRED)
  isRequired       Boolean              @default(true)
  quantity         Int                  @default(1)
  quantityExpected Int                  @default(1)
  sortOrder        Int                  @default(0)
  notes            String?
  addedAt          DateTime             @default(now())
  removedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kit          InventoryKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  gearItem     GearItem     @relation(fields: [gearItemId], references: [id], onDelete: Restrict)

  @@unique([kitId, gearItemId])
  @@index([organizationId, kitId])
  @@index([organizationId, kitId, componentRole])
  @@index([organizationId, gearItemId])
}

// Arc 20X: GearKitInspection — records a kit inspection event with per-item condition observations
model GearKitInspection {
  id                  String                  @id @default(cuid())
  organizationId      String
  kitId               String
  inspectedByPersonId String
  status              GearKitInspectionStatus
  notes               String?
  itemConditionsJson  String?
  missingItemIdsJson  String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kit          InventoryKit @relation(fields: [kitId], references: [id], onDelete: Restrict)
  inspector    Person       @relation("GearKitInspectionInspector", fields: [inspectedByPersonId], references: [id], onDelete: Restrict)

  @@index([organizationId, kitId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, inspectedByPersonId, createdAt])
}

// Arc 20X: GearKitCustodyEvent — immutable append-only custody event log for kit-level operations
model GearKitCustodyEvent {
  id                 String                  @id @default(cuid())
  organizationId     String
  kitId              String
  eventType          GearKitCustodyEventType
  actorPersonId      String
  custodyPersonId    String?
  relatedEventId     String?
  notes              String?
  childItemIdsJson   String?
  isPartial          Boolean                 @default(false)
  occurredAt         DateTime                @default(now())
  createdAt          DateTime                @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kit             InventoryKit  @relation(fields: [kitId], references: [id], onDelete: Restrict)
  actor           Person        @relation("GearKitCustodyEventActor", fields: [actorPersonId], references: [id], onDelete: Restrict)
  custodyPerson   Person?       @relation("GearKitCustodyEventCustody", fields: [custodyPersonId], references: [id], onDelete: SetNull)
  relatedEvent    Event?        @relation("GearKitCustodyEventEvent", fields: [relatedEventId], references: [id], onDelete: SetNull)

  @@index([organizationId, kitId, occurredAt])
  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, actorPersonId, occurredAt])
  @@index([organizationId, custodyPersonId, occurredAt])
  @@index([organizationId, relatedEventId, occurredAt])
}

// Arc 20B: InventoryScanEvent — immutable scan activity records for barcode/QR operational workflows
model InventoryScanEvent {
  id                      String   @id @default(cuid())
  organizationId          String
  actorPersonId           String?
  gearItemId              String?
  locationId              String?
  scanContext             String
  rawValue                String
  normalizedValue         String
  inventoryIdentifierType String
  matchType               String
  result                  String
  workflowTarget          String?
  metadataJson            String?
  createdAt               DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        Person?                @relation("InventoryScanEventActor", fields: [actorPersonId], references: [id], onDelete: SetNull)
  gearItem     GearItem?              @relation(fields: [gearItemId], references: [id], onDelete: SetNull)
  location     InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  auditResults InventoryAuditResult[]

  @@index([organizationId, createdAt])
  @@index([organizationId, scanContext, createdAt])
  @@index([organizationId, result, createdAt])
  @@index([organizationId, gearItemId, createdAt])
  @@index([organizationId, locationId, createdAt])
}

// Arc 20C: Inventory audit and reconciliation workflow models

model InventoryAudit {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  auditType         InventoryAuditType
  scope             InventoryAuditScope
  scopeReferenceId  String?
  cadenceDays       Int?
  nextScheduledAt   DateTime?
  lastExecutedAt    DateTime?
  createdByPersonId String
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    Person                  @relation("InventoryAuditCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  sessions     InventoryAuditSession[]

  @@unique([organizationId, name])
  @@index([organizationId, auditType])
  @@index([organizationId, scope])
  @@index([organizationId, archivedAt])
  @@index([organizationId, nextScheduledAt])
}

model InventoryAuditSession {
  id                  String                      @id @default(cuid())
  organizationId      String
  inventoryAuditId    String?
  title               String
  status              InventoryAuditSessionStatus @default(DRAFT)
  scopeSnapshotJson   String?
  plannedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  startedByPersonId   String?
  completedByPersonId String?
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  organization  Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audit         InventoryAudit?             @relation(fields: [inventoryAuditId], references: [id], onDelete: SetNull)
  startedBy     Person?                     @relation("InventoryAuditSessionStartedBy", fields: [startedByPersonId], references: [id], onDelete: SetNull)
  completedBy   Person?                     @relation("InventoryAuditSessionCompletedBy", fields: [completedByPersonId], references: [id], onDelete: SetNull)
  checkpoints   InventoryAuditCheckpoint[]
  results       InventoryAuditResult[]
  discrepancies InventoryAuditDiscrepancy[]

  @@index([organizationId, status, startedAt])
  @@index([organizationId, inventoryAuditId, status])
  @@index([organizationId, plannedAt])
}

model InventoryAuditCheckpoint {
  id                String                         @id @default(cuid())
  organizationId    String
  auditSessionId    String
  label             String
  orderIndex        Int                            @default(0)
  status            InventoryAuditCheckpointStatus @default(PENDING)
  expectedItemCount Int?
  verifiedItemCount Int                            @default(0)
  discrepancyCount  Int                            @default(0)
  notes             String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditSession InventoryAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, auditSessionId, orderIndex])
  @@index([organizationId, status])
}

model InventoryAuditResult {
  id                      String                      @id @default(cuid())
  organizationId          String
  auditSessionId          String
  gearItemId              String?
  scanEventId             String?
  verificationStatus      InventoryVerificationStatus @default(PENDING)
  expectedLocationId      String?
  observedLocationId      String?
  expectedCustodyPersonId String?
  observedCustodyPersonId String?
  expectedQuantity        Int?
  observedQuantity        Int?
  expectedReadinessState  InventoryReadinessState?
  observedReadinessState  InventoryReadinessState?
  observedConditionStatus GearConditionStatus?
  scannedCode             String?
  notes                   String?
  verifiedAt              DateTime                    @default(now())
  verifiedByPersonId      String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditSession          InventoryAuditSession       @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  gearItem              GearItem?                   @relation(fields: [gearItemId], references: [id], onDelete: SetNull)
  scanEvent             InventoryScanEvent?         @relation(fields: [scanEventId], references: [id], onDelete: SetNull)
  expectedLocation      InventoryLocation?          @relation("InventoryAuditExpectedLocation", fields: [expectedLocationId], references: [id], onDelete: SetNull)
  observedLocation      InventoryLocation?          @relation("InventoryAuditObservedLocation", fields: [observedLocationId], references: [id], onDelete: SetNull)
  expectedCustodyPerson Person?                     @relation("InventoryAuditExpectedCustody", fields: [expectedCustodyPersonId], references: [id], onDelete: SetNull)
  observedCustodyPerson Person?                     @relation("InventoryAuditObservedCustody", fields: [observedCustodyPersonId], references: [id], onDelete: SetNull)
  verifiedBy            Person?                     @relation("InventoryAuditResultVerifiedBy", fields: [verifiedByPersonId], references: [id], onDelete: SetNull)
  discrepancies         InventoryAuditDiscrepancy[]

  @@index([organizationId, auditSessionId, verificationStatus])
  @@index([organizationId, gearItemId, verifiedAt])
  @@index([organizationId, verifiedAt])
  @@index([organizationId, expectedLocationId])
  @@index([organizationId, observedLocationId])
}

model InventoryAuditDiscrepancy {
  id                 String                     @id @default(cuid())
  organizationId     String
  auditSessionId     String
  auditResultId      String?
  gearItemId         String?
  locationId         String?
  discrepancyType    InventoryDiscrepancyType
  status             InventoryDiscrepancyStatus @default(OPEN)
  summary            String
  details            String?
  detectedAt         DateTime                   @default(now())
  resolvedAt         DateTime?
  resolvedByPersonId String?
  resolutionNotes    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditSession InventoryAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  auditResult  InventoryAuditResult? @relation(fields: [auditResultId], references: [id], onDelete: SetNull)
  gearItem     GearItem?             @relation(fields: [gearItemId], references: [id], onDelete: SetNull)
  location     InventoryLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  resolvedBy   Person?               @relation("InventoryAuditDiscrepancyResolvedBy", fields: [resolvedByPersonId], references: [id], onDelete: SetNull)

  @@index([organizationId, auditSessionId, status])
  @@index([organizationId, discrepancyType, status])
  @@index([organizationId, gearItemId, status])
  @@index([organizationId, locationId, status])
}

// ── Arc 23C: Prompt Library and Prompt Assignment ────────────────────────────

enum JournalAssignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

// Arc 23C: JournalPrompt — reusable prompt template for the prompt library.
// Staff/coaches create prompts here; athletes or staff can assign them.
model JournalPrompt {
  id                String    @id @default(cuid())
  organizationId    String
  title             String
  promptText        String
  category          String?
  tags              String[]  @default([])
  active            Boolean   @default(true)
  createdByPersonId String
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    Person              @relation("JournalPromptCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  assignments  JournalAssignment[]
  responses    Entry[]             @relation("JournalPromptResponses")

  @@index([organizationId, active, createdAt])
  @@index([organizationId, category])
}

// Arc 23C: JournalAssignment — staff/coach-assigned prompt with optional due window.
// Can target a single athlete (assignedToAthletePersonId) or a team (assignedToTeamId).
model JournalAssignment {
  id                        String                  @id @default(cuid())
  organizationId            String
  promptId                  String
  assignedToAthletePersonId String?
  assignedToTeamId          String?
  assignedByPersonId        String
  scheduledFor              DateTime?
  dueAt                     DateTime?
  status                    JournalAssignmentStatus @default(ACTIVE)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prompt            JournalPrompt @relation(fields: [promptId], references: [id], onDelete: Restrict)
  assignedToAthlete Person?       @relation("JournalAssignmentToAthlete", fields: [assignedToAthletePersonId], references: [id], onDelete: SetNull)
  assignedToTeam    Team?         @relation(fields: [assignedToTeamId], references: [id], onDelete: SetNull)
  assignedBy        Person        @relation("JournalAssignmentBy", fields: [assignedByPersonId], references: [id], onDelete: Restrict)
  responses         Entry[]       @relation("JournalAssignmentResponses")

  @@index([organizationId, promptId])
  @@index([organizationId, assignedToAthletePersonId, status])
  @@index([organizationId, assignedToTeamId, status])
  @@index([organizationId, assignedByPersonId])
  @@index([organizationId, status, dueAt])
}

// ── Arc 23D: Habit Model, Recurrence, and Completion Tracking ────────────────

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum HabitStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// Arc 23D: Habit — a recurring behavior or check-in target tracked over time.
// May be self-defined by an athlete or assigned by staff/coach.
model Habit {
  id                String      @id @default(cuid())
  organizationId    String
  title             String
  description       String?
  athletePersonId   String
  assignedToTeamId  String?
  status            HabitStatus @default(ACTIVE)
  createdByPersonId String
  archivedAt        DateTime?
  pausedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  athlete        Person            @relation("HabitAthlete", fields: [athletePersonId], references: [id], onDelete: Restrict)
  assignedToTeam Team?             @relation("HabitTeam", fields: [assignedToTeamId], references: [id], onDelete: SetNull)
  createdBy      Person            @relation("HabitCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  schedules      HabitSchedule[]
  completions    HabitCompletion[]

  @@index([organizationId, athletePersonId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, assignedToTeamId])
  @@index([organizationId, createdByPersonId])
}

// Arc 23D: HabitSchedule — recurrence/cadence definition for a Habit.
// A Habit may have one or more schedule records (e.g. to represent schedule changes).
model HabitSchedule {
  id         String         @id @default(cuid())
  habitId    String
  frequency  HabitFrequency
  daysOfWeek String?        // JSON array, e.g. ["MON","WED","FRI"], used for WEEKLY frequency
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
}

// Arc 23D: HabitCompletion — a dated check-in record for a Habit.
// Unique on (habitId, completedOn) to prevent duplicate same-day completions.
// completedOn is stored as start-of-day UTC for consistent deduplication.
model HabitCompletion {
  id              String   @id @default(cuid())
  habitId         String
  athletePersonId String
  completedOn     DateTime // normalized to start-of-day UTC
  note            String?
  createdAt       DateTime @default(now())

  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  athlete Person @relation("HabitCompletionAthlete", fields: [athletePersonId], references: [id], onDelete: Restrict)

  @@unique([habitId, completedOn])
  @@index([habitId, completedOn])
  @@index([athletePersonId, completedOn])
}
