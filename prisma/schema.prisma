model Entry {
  id                 String          @id @default(cuid())
  organizationId     String
  teamId             String?
  type               EntryType
  title              String
  content            String?
  tags               String[]        @default([])
  createdByPersonId  String
  updatedByPersonId  String?
  assignedToPersonId String?
  visibility         EntryVisibility @default(STAFF_ONLY)
  status             EntryStatus     @default(OPEN)
  priority           EntryPriority   @default(MEDIUM)
  dueDate            DateTime?
  dueTime            String?
  occurredAt         DateTime?
  startDate          DateTime?
  endDate            DateTime?
  timezone           String?
  parentEntryId      String?
  version            Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  taskCompleted      Boolean         @default(false)
  completedAt        DateTime?
  taskChecklistJson  String?
  taskRemindersJson  String?
  taskRecurrenceRule String?
  noteIsPinned       Boolean         @default(false)
  noteIsFavorite     Boolean         @default(false)
  noteChecklistJson  String?
  sourceTaskId       String?         @unique
  sourceNoteId       String?         @unique
  // Arc 23C: optional linkage to prompt library and assignment
  journalPromptId    String?
  journalAssignmentId String?
  // Arc 24D.4: optional entry list assignment
  listId             String?

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team                 Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy            Person               @relation("EntryCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  updatedBy            Person?              @relation("EntryUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)
  assignedTo           Person?              @relation("EntryAssignedTo", fields: [assignedToPersonId], references: [id], onDelete: SetNull)
  parentEntry          Entry?               @relation("EntryParentChild", fields: [parentEntryId], references: [id], onDelete: SetNull)
  childEntries         Entry[]              @relation("EntryParentChild")
  linkedFrom           EntryLink[]          @relation("EntryLinkFrom")
  linkedTo             EntryLink[]          @relation("EntryLinkTo")
  activity             EntryActivity[]
  objectLinks          EntryObjectLink[]
  assignments          EntryAssignment[]
  statusHistory        EntryStatusHistory[]
  comments             EntryComment[]
  reminders            EntryReminder[]
  sourceTask           FollowUpTask?        @relation("TaskEntry", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  sourceNote           ObservationNote?     @relation("NoteEntry", fields: [sourceNoteId], references: [id], onDelete: SetNull)
  anchoredWorkflowRuns WorkflowRun[]
  workflowStepEntry    WorkflowStepEntry?
  awarenessEvents      AwarenessEvent[]
  notifications        Notification[]
  journalPrompt        JournalPrompt?       @relation("JournalPromptResponses", fields: [journalPromptId], references: [id], onDelete: SetNull)
  journalAssignment    JournalAssignment?   @relation("JournalAssignmentResponses", fields: [journalAssignmentId], references: [id], onDelete: SetNull)
  entryList            EntryList?           @relation("EntryListEntries", fields: [listId], references: [id], onDelete: SetNull)
  typePayloads         EntryTypePayload[]

  @@index([organizationId, type, createdAt])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, deletedAt])
  @@index([organizationId, createdByPersonId])
  @@index([organizationId, assignedToPersonId])
  @@index([organizationId, parentEntryId])
  @@index([organizationId, journalPromptId])
  @@index([organizationId, journalAssignmentId])
  @@index([organizationId, listId])
}

// Arc 24D.5: EntryTypePayload — generic type-scoped structured metadata with active/archive state.
model EntryTypePayload {
  id             String    @id @default(cuid())
  organizationId String
  entryId        String
  entryType      EntryType
  payloadJson    String
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry        Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, entryType])
  @@index([organizationId, entryType, isActive, updatedAt])
  @@index([organizationId, entryId])
}

model EntryLink {
  id                String   @id @default(cuid())
  organizationId    String
  fromEntryId       String
  toEntryId         String
  createdByPersonId String
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromEntry    Entry        @relation("EntryLinkFrom", fields: [fromEntryId], references: [id], onDelete: Cascade)
  toEntry      Entry        @relation("EntryLinkTo", fields: [toEntryId], references: [id], onDelete: Cascade)
  createdBy    Person       @relation("EntryLinkCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)

  @@unique([organizationId, fromEntryId, toEntryId])
  @@index([organizationId, fromEntryId])
  @@index([organizationId, toEntryId])
}

// Arc 24D.4: EntryList — scoped lists for organizing entries

model EntryList {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  scope          EntryListScope
  isInbox        Boolean        @default(false)
  isArchived     Boolean        @default(false)
  // PERSONAL scope: ownerPersonId is required; programId/teamId are null
  ownerPersonId  String?
  // PROGRAM scope: programId is required; teamId is null
  programId      String?
  // TEAM scope: programId and teamId are both required
  teamId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        Person?      @relation("EntryListOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  program      Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  entries      Entry[]      @relation("EntryListEntries")

  @@index([organizationId, scope])
  @@index([organizationId, ownerPersonId])
  @@index([organizationId, programId])
  @@index([organizationId, teamId])
}

