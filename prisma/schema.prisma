  reservedEvent Event?       @relation(fields: [reservedForEventId], references: [id], onDelete: SetNull)
  requestedBy   Person       @relation("GearReservationRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  approvedBy    Person?      @relation("GearReservationApprovedBy", fields: [approvedByPersonId], references: [id], onDelete: SetNull)
  releasedBy    Person?      @relation("GearReservationReleasedBy", fields: [releasedByPersonId], references: [id], onDelete: SetNull)

  @@index([organizationId, gearItemId, status])
  @@index([organizationId, windowStartAt, status])
  @@index([organizationId, windowEndAt, status])
  @@index([organizationId, reservedForPersonId, status])
  @@index([organizationId, reservedForTeamId, status])
  @@index([organizationId, reservedForEventId, status])
  @@index([organizationId, purpose, status])
}

model GearMaintenanceLog {
  id                  String               @id @default(cuid())
  organizationId      String
  gearItemId          String
  performedByPersonId String
  maintenanceType     GearMaintenanceType
  performedAt         DateTime             @default(now())
  conditionBefore     GearConditionStatus?
  conditionAfter      GearConditionStatus?
  notes               String
  // Arc 20Y: scheduling fields set when maintenance is recorded
  nextMaintenanceDueAt DateTime?
  isPostEventRecovery  Boolean             @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItem     GearItem     @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  performedBy  Person       @relation(fields: [performedByPersonId], references: [id], onDelete: Restrict)

  @@index([organizationId, gearItemId, performedAt])
  @@index([organizationId, performedByPersonId, performedAt])
  @@index([organizationId, maintenanceType, performedAt])
}

// Arc 20Y: GearInspectionRecord — records a formal inspection result for a single gear item
model GearInspectionRecord {
  id                    String                    @id @default(cuid())
  organizationId        String
  gearItemId            String
  inspectedByPersonId   String
  result                GearItemInspectionResult
