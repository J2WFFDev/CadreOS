  guardianApprovalRequired    Boolean                  @default(false)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  organization                  Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItems                     GearItem[]
  eventGearRequirements         EventGearRequirement[]
  categoryFields                GearCategoryField[]
  eventGearRequirementTemplates EventGearRequirementTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId, inventoryType])
  @@index([organizationId, behaviorType])
  @@index([organizationId, reportGroup])
}

model GearItem {
  id                     String                    @id @default(cuid())
  organizationId         String
  programId              String?
  gearCategoryId         String
  name                   String
  inventoryType          GearInventoryType
  // Arc 20Z: human-readable asset identity (e.g. GO-RIFLE-0007). Auto-generated on create; admin-overridable.
  assetId                String?
  sku                    String?
  serialNumber           String?
  quantityOnHand         Int                       @default(0)
  quantityMin            Int?
  lifecycleStatus        GearItemLifecycleStatus   @default(ACTIVE)
  conditionStatus        GearConditionStatus?
  ownershipType          InventoryOwnershipType?
  readinessState         InventoryReadinessState?
  locationId             String?
  barcodeValue           String?
  notes                  String?
  // Arc 20Y: inspection tracking fields
  lastInspectedAt        DateTime?
  lastInspectionResult   GearItemInspectionResult?
  nextInspectionDueAt    DateTime?
  inspectionDueStatus    GearInspectionDueStatus   @default(NOT_SCHEDULED)
  // Arc 20Y: maintenance scheduling fields
  nextMaintenanceDueAt   DateTime?
  maintenanceDueStatus   GearMaintenanceDueStatus  @default(NOT_SCHEDULED)
  // Arc 20Y: usage counters for interval-based schedules
  totalUseCount          Int                       @default(0)
  totalDeploymentCount   Int                       @default(0)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  organization                Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program                     Program?                    @relation(fields: [programId], references: [id], onDelete: SetNull)
  category                    GearCategory                @relation(fields: [gearCategoryId], references: [id], onDelete: Restrict)
  location                    InventoryLocation?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments                 GearAssignment[]
  checkouts                   GearCheckout[]
  reservations                GearReservation[]
  maintenanceLogs             GearMaintenanceLog[]
  inspectionRecords           GearInspectionRecord[]
  consumableTransactions      ConsumableTransaction[]
  eventGearAssignments        EventGearAssignment[]
  inventoryMovements          InventoryMovement[]
  kitItems                    InventoryKitItem[]
  scanEvents                  InventoryScanEvent[]
  inventoryAuditResults       InventoryAuditResult[]
  inventoryAuditDiscrepancies InventoryAuditDiscrepancy[]

  @@unique([organizationId, serialNumber])
  @@unique([organizationId, assetId])
  @@index([organizationId, assetId])
  @@index([organizationId, gearCategoryId])
  @@index([organizationId, programId])
  @@index([organizationId, inventoryType, lifecycleStatus])
  @@index([organizationId, locationId])
  @@index([organizationId, readinessState])
  @@index([organizationId, inspectionDueStatus])
  @@index([organizationId, maintenanceDueStatus])
  @@index([organizationId, nextInspectionDueAt])
  @@index([organizationId, nextMaintenanceDueAt])
}

model GearAssignment {
  id                 String               @id @default(cuid())
  organizationId     String
  gearItemId         String
  assignedToPersonId String?
  assignedToTeamId   String?
  assignedToEventId  String?
  assignedByPersonId String
  assignedAt         DateTime             @default(now())
  expectedReturnAt   DateTime?
  returnedAt         DateTime?
  status             GearAssignmentStatus @default(PENDING)
