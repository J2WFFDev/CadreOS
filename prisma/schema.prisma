  receivedBy   Person?      @relation("GearCheckoutReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([organizationId, gearItemId, status])
  @@index([organizationId, checkedOutById, status])
  @@index([organizationId, issuedById, status])
  @@index([organizationId, eventId, status])
  @@index([organizationId, expectedReturnAt, status])
}

model GearReservation {
  id                  String                 @id @default(cuid())
  organizationId      String
  gearItemId          String
  programId           String?
  reservedForPersonId String?
  reservedForTeamId   String?
  reservedForEventId  String?
  requestedByPersonId String
  approvedByPersonId  String?
  releasedByPersonId  String?
  mode                GearReservationMode    @default(HARD_RESERVATION)
  holdType            GearHoldType?
  purpose             GearReservationPurpose @default(OTHER)
  status              GearReservationStatus  @default(ACTIVE)
  approvalStatus      ApprovalStatus         @default(NOT_REQUIRED)
  quantityRequested   Int                    @default(1)
  windowStartAt       DateTime
  windowEndAt         DateTime
  notes               String?
  releaseReason       String?
  conflictSummary     String?
  releasedAt          DateTime?
  fulfilledAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gearItem      GearItem     @relation(fields: [gearItemId], references: [id], onDelete: Restrict)
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
