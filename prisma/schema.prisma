model Organization {
  id        String    @id @default(cuid())
  name      String
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  programs                     Program[]
  people                       Person[]
  users                        UserAccount[]
  teams                        Team[]
  seasons                      Season[]
  roleAssignments              RoleAssignment[]
  athleteGuardianRelationships AthleteGuardianRelationship[]
  rosterMemberships            RosterMembership[]
  observationNotes             ObservationNote[]
  events                       Event[]
  rsvps                        RSVP[]
  attendanceRecords            AttendanceRecord[]
  followUpTasks                FollowUpTask[]
  entryRuntimeRefs             EntryRuntimeRef[]
  inboxRoutingItems            InboxRoutingItem[]
  auditEvents                  AuditEvent[]
  facilities                   Facility[]
  facilityResources            FacilityResource[]
  resourceBookings             ResourceBooking[]
  bookingConflicts             BookingConflict[]
  gearCategories               GearCategory[]
  gearItems                    GearItem[]
  gearAssignments              GearAssignment[]
  gearCheckouts                GearCheckout[]
  gearReservations             GearReservation[]
  gearMaintenanceLogs          GearMaintenanceLog[]
  gearInspectionRecords        GearInspectionRecord[]
  consumableTransactions       ConsumableTransaction[]
  eventGearPlans               EventGearPlan[]
  eventGearRequirements        EventGearRequirement[]
  eventGearAssignments         EventGearAssignment[]
  inventoryLocations           InventoryLocation[]
  inventoryMovements           InventoryMovement[]
  inventoryKits                InventoryKit[]
  inventoryKitItems            InventoryKitItem[]
  gearKitInspections           GearKitInspection[]
  gearKitCustodyEvents         GearKitCustodyEvent[]
  inventoryScanEvents          InventoryScanEvent[]
  inventoryAudits              InventoryAudit[]
  inventoryAuditSessions       InventoryAuditSession[]
  inventoryAuditResults        InventoryAuditResult[]
  inventoryAuditDiscrepancies  InventoryAuditDiscrepancy[]
  inventoryAuditCheckpoints    InventoryAuditCheckpoint[]
  gearCategoryFields           GearCategoryField[]
  eventGearRequirementTemplates EventGearRequirementTemplate[]
  gearOpsSettings              GearOpsOrganizationSettings?
  entries                      Entry[]
  journalPrompts               JournalPrompt[]
  journalAssignments           JournalAssignment[]
  // Arc 23D: Habit back-relations
  habits                       Habit[]
  entryLists                   EntryList[]
  entryLinks                   EntryLink[]
  entryActivities              EntryActivity[]
  entryObjectLinks             EntryObjectLink[]
  entryTypePayloads            EntryTypePayload[]
  entryAssignments             EntryAssignment[]
  entryStatusHistory           EntryStatusHistory[]
  entryComments                EntryComment[]
  entryReminders               EntryReminder[]
  operationalRelationships     OperationalRelationship[]
  workflowTemplates            WorkflowTemplate[]
  workflowRuns                 WorkflowRun[]
  workflowStepEntries          WorkflowStepEntry[]
  awarenessEvents              AwarenessEvent[]
  notifications                Notification[]
  notificationReadStates       NotificationReadState[]
  notificationPreferences      NotificationPreference[]
  notificationDigests          NotificationDigest[]
}

model Program {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teams            Team[]
  seasons          Season[]
  roles            RoleAssignment[]
  events           Event[]
  auditEvents      AuditEvent[]
  resourceBookings ResourceBooking[]
  gearItems        GearItem[]
  gearReservations GearReservation[]
  // Arc 24D.4: Entry lists scoped to this program
  entryLists       EntryList[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  programId      String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program          Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  roles            RoleAssignment[]
  roster           RosterMembership[]
  notes            ObservationNote[]
  events           Event[]
  auditEvents      AuditEvent[]
  resourceBookings ResourceBooking[]
  gearAssignments  GearAssignment[]
  gearReservations GearReservation[]
  assignedKits     InventoryKit[]    @relation("InventoryKitAssignedToTeam")
  entries          Entry[]
  journalAssignments JournalAssignment[]
  // Arc 23D: Habit back-relations
  assignedHabits   Habit[]           @relation("HabitTeam")
  // Arc 24D.4: Entry lists scoped to this team
  entryLists       EntryList[]

  @@unique([programId, name])
  @@index([organizationId, programId])
}

model Season {
  id             String    @id @default(cuid())
  organizationId String
  programId      String
  name           String
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  roster       RosterMembership[]

  @@unique([programId, name])
  @@index([organizationId, programId])
}

model UserAccount {
  id             String   @id @default(cuid())
  organizationId String
  clerkUserId    String   @unique
  personId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Person {
  id              String                @id @default(cuid())
  organizationId  String
  lifecycleStatus MemberLifecycleStatus @default(ACTIVE)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization                         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccounts                         UserAccount[]
  roles                                RoleAssignment[]
  roster                               RosterMembership[]
  authoredNotes                        ObservationNote[]             @relation("NoteAuthor")
  athleteNotes                         ObservationNote[]             @relation("NoteAthlete")
  eventRsvps                           RSVP[]
  attendance                           AttendanceRecord[]            @relation("AttendancePerson")
  markedAttendanceRecords              AttendanceRecord[]            @relation("AttendanceMarkedBy")
  assignedTasks                        FollowUpTask[]                @relation("TaskAssignee")
  createdTasks                         FollowUpTask[]                @relation("TaskCreator")
  authoredEntryRuntimeRefs             EntryRuntimeRef[]             @relation("EntryRuntimeRefAuthor")
  guardianLinks                        AthleteGuardianRelationship[] @relation("GuardianSide")
  athleteLinks                         AthleteGuardianRelationship[] @relation("AthleteSide")
  ownedInboxRoutingItems               InboxRoutingItem[]            @relation("InboxOwner")
  createdInboxRoutingItems             InboxRoutingItem[]            @relation("InboxCreatedBy")
  createdEvents                        Event[]                       @relation("EventCreatedBy")
  actorAuditEvents                     AuditEvent[]                  @relation("AuditActor")
  requestedBookings                    ResourceBooking[]             @relation("BookingRequestedBy")
  approvedBookings                     ResourceBooking[]             @relation("BookingApprovedBy")
  assignedGear                         GearAssignment[]              @relation("GearAssignmentToPerson")
  createdGearAssignments               GearAssignment[]              @relation("GearAssignmentByPerson")
  checkedOutGear                       GearCheckout[]                @relation("GearCheckoutTakenBy")
  issuedGear                           GearCheckout[]                @relation("GearCheckoutIssuedBy")
  returnedGear                         GearCheckout[]                @relation("GearCheckoutReturnedBy")
  receivedGear                         GearCheckout[]                @relation("GearCheckoutReceivedBy")
  requestedGearReservations            GearReservation[]             @relation("GearReservationRequestedBy")
  reservedGearReservations             GearReservation[]             @relation("GearReservationReservedFor")
  approvedGearReservations             GearReservation[]             @relation("GearReservationApprovedBy")
  releasedGearReservations             GearReservation[]             @relation("GearReservationReleasedBy")
  gearMaintenanceLogs                  GearMaintenanceLog[]
  gearInspectionRecords                GearInspectionRecord[]         @relation("GearInspectionRecordInspectedBy")
  recordedConsumableTransactions       ConsumableTransaction[]
  createdEventGearPlans                EventGearPlan[]               @relation("EventGearPlanCreatedBy")
  preparedEventGearPlans               EventGearPlan[]               @relation("EventGearPlanPreparedBy")
  createdEventGearAssignments          EventGearAssignment[]         @relation("EventGearAssignmentCreatedBy")
  stagedEventGearAssignments           EventGearAssignment[]         @relation("EventGearAssignmentStagedBy")
  recoveredEventGearAssignments        EventGearAssignment[]         @relation("EventGearAssignmentRecoveredBy")
  createdEntries                       Entry[]                       @relation("EntryCreatedBy")
  updatedEntries                       Entry[]                       @relation("EntryUpdatedBy")
  assignedEntries                      Entry[]                       @relation("EntryAssignedTo")
  createdEntryLinks                    EntryLink[]                   @relation("EntryLinkCreatedBy")
  entryActivities                      EntryActivity[]               @relation("EntryActivityActor")
  createdEntryObjectLinks              EntryObjectLink[]             @relation("EntryObjectLinkCreatedBy")
  entryAssignments                     EntryAssignment[]             @relation("EntryAssignmentToPerson")
  givenEntryAssignments                EntryAssignment[]             @relation("EntryAssignmentByPerson")
  entryStatusChanges                   EntryStatusHistory[]          @relation("EntryStatusChangedBy")
  entryComments                        EntryComment[]                @relation("EntryCommentAuthor")
  entryReminders                       EntryReminder[]               @relation("EntryReminderPerson")
  createdOperationalRelationships      OperationalRelationship[]     @relation("OperationalRelationshipCreatedBy")
  createdWorkflowTemplates             WorkflowTemplate[]            @relation("WorkflowTemplateCreatedBy")
  startedWorkflowRuns                  WorkflowRun[]                 @relation("WorkflowRunStartedBy")
  awarenessEvents                      AwarenessEvent[]              @relation("AwarenessEventActor")
  notificationReadStates               NotificationReadState[]
  notificationPreferences              NotificationPreference[]
  notificationDigests                  NotificationDigest[]
  actorInventoryMovements              InventoryMovement[]           @relation("InventoryMovementActor")
  custodyInventoryMovements            InventoryMovement[]           @relation("InventoryMovementCustody")
  ownedInventoryKits                   InventoryKit[]                @relation("InventoryKitOwner")
  assignedKits                         InventoryKit[]                @relation("InventoryKitAssignedTo")
  gearKitInspections                   GearKitInspection[]           @relation("GearKitInspectionInspector")
  actorGearKitCustodyEvents            GearKitCustodyEvent[]         @relation("GearKitCustodyEventActor")
  custodyGearKitCustodyEvents          GearKitCustodyEvent[]         @relation("GearKitCustodyEventCustody")
  inventoryScanEvents                  InventoryScanEvent[]          @relation("InventoryScanEventActor")
  createdInventoryAudits               InventoryAudit[]              @relation("InventoryAuditCreatedBy")
  startedInventoryAuditSessions        InventoryAuditSession[]       @relation("InventoryAuditSessionStartedBy")
  completedInventoryAuditSessions      InventoryAuditSession[]       @relation("InventoryAuditSessionCompletedBy")
  verifiedInventoryAuditResults        InventoryAuditResult[]        @relation("InventoryAuditResultVerifiedBy")
  resolvedInventoryAuditDiscrepancies  InventoryAuditDiscrepancy[]   @relation("InventoryAuditDiscrepancyResolvedBy")
  expectedCustodyInventoryAuditResults InventoryAuditResult[]        @relation("InventoryAuditExpectedCustody")
  observedCustodyInventoryAuditResults InventoryAuditResult[]        @relation("InventoryAuditObservedCustody")
  createdJournalPrompts                JournalPrompt[]               @relation("JournalPromptCreatedBy")
  givenJournalAssignments              JournalAssignment[]           @relation("JournalAssignmentBy")
  receivedJournalAssignments           JournalAssignment[]           @relation("JournalAssignmentToAthlete")
  // Arc 23D: Habit back-relations
  athleteHabits                        Habit[]                       @relation("HabitAthlete")
  createdHabits                        Habit[]                       @relation("HabitCreatedBy")
  habitCompletions                     HabitCompletion[]             @relation("HabitCompletionAthlete")
  // Arc 24D.4: Personal entry lists owned by this person
  ownedEntryLists                      EntryList[]                   @relation("EntryListOwner")

  @@index([organizationId])
  @@index([organizationId, lifecycleStatus])
  @@index([organizationId, lastName, firstName])
}

model RoleAssignment {
  id             String    @id @default(cuid())
  organizationId String
  personId       String
  roleType       RoleType
  scopeType      ScopeType
  programId      String?
  teamId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  program      Program?     @relation(fields: [programId], references: [id], onDelete: Restrict)
